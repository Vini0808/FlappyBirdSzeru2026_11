<Window x:Class="FlappyBirdSzeru2026_11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlappyBirdSzeru2026_11"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="SkyBlue" Focusable="True">
            <Rectangle x:Name="Bird" Width="30" Height="30" Fill="Yellow"/>
            <Rectangle x:Name="PipeTop" Width="60" Height="200" Fill="Green" Canvas.Left="500" Canvas.Top="0"/>
            <Rectangle x:Name="PipeBottom" Width="60" Height="200" Fill="Green" Canvas.Left="500" Canvas.Top="350"/>
        </Canvas>
    </Grid>
</Window>
